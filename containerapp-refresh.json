{
  "properties": {
    "template": {
      "containers": [
        {
          "name": "onboarding",
          "image": "python:3.12-slim",
          "command": ["/bin/sh"],
          "args": ["-c", "apt-get update && apt-get install -y --no-install-recommends git && rm -rf /var/lib/apt/lists/* && git clone --branch feat/azure-foundry-onboarding --single-branch https://github.com/Aryan-verma-ai/employee-onboarding-agent-app.git /srv/app && cd /srv/app && pip install --no-cache-dir . && python -m alembic upgrade head && exec uvicorn app.main:app --host 0.0.0.0 --port 8000 --workers 1"],
          "resources": {"cpu": 0.5, "memory": "1Gi"},
          "env": [
            {"name": "ENVIRONMENT", "value": "production"},
            {"name": "ALLOW_DEV_AUTH", "value": "false"},
            {"name": "DATABASE_URL", "secretRef": "db-url"},
            {"name": "AZURE_STORAGE_CONNECTION_STRING", "secretRef": "storage-connection"},
            {"name": "ENTRA_TENANT_ID", "value": "a8780332-fecd-4f97-81b8-3782131af31a"},
            {"name": "ENTRA_AUDIENCE", "value": "88b93c60-7e61-48cb-9802-4a3eb761dfa6"},
            {"name": "ENTRA_SPA_CLIENT_ID", "value": "73459c7d-1ad9-4cfc-b01a-aa981bd54397"},
            {"name": "ENTRA_API_SCOPE", "value": "api://88b93c60-7e61-48cb-9802-4a3eb761dfa6/access_as_user"},
            {"name": "ENTRA_REDIRECT_URI", "value": "https://eonbdemo922app.icyflower-fd71ac7e.koreacentral.azurecontainerapps.io/auth/callback"},
            {"name": "AZURE_STORAGE_ACCOUNT_URL", "value": "https://eonbdemo9226f25.blob.core.windows.net/"},
            {"name": "AZURE_STORAGE_CONTAINER", "value": "onboarding-private"},
            {"name": "AZURE_DOCUMENT_INTELLIGENCE_ENDPOINT", "value": "https://employee-onboarding-kc-resource.cognitiveservices.azure.com/"},
            {"name": "FOUNDRY_PROJECT_ENDPOINT", "value": "https://employee-onboarding-kc-resource.services.ai.azure.com/api/projects/employee-onboarding-agent-kc"},
            {"name": "FOUNDRY_AGENT_NAME", "value": "employee-onboarding"},
            {"name": "FOUNDRY_AGENT_VERSION", "value": "9"},
            {"name": "FOUNDRY_AUTH_MODE", "value": "api_key"},
            {"name": "AZURE_OPENAI_API_KEY", "secretRef": "azure-ai-key"},
            {"name": "AZURE_DOCUMENT_INTELLIGENCE_AUTH_MODE", "value": "api_key"},
            {"name": "WORKER_TENANT_ID", "value": "a8780332-fecd-4f97-81b8-3782131af31a"},
            {"name": "WORKER_SUBJECT", "value": "onboarding-worker"},
            {"name": "DEMO_DEPLOYMENT", "value": "post-completion-all-fields-update-v9"}
          ]
        }
      ],
      "scale": {
        "minReplicas": 1,
        "maxReplicas": 1,
        "rules": [{"name": "http", "http": {"metadata": {"concurrentRequests": "10"}}}]
      }
    }
  }
}
