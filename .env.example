ENVIRONMENT=development
ALLOW_DEV_AUTH=true
DATABASE_URL=sqlite:///./onboarding.db
EMPLOYEE_ID_PREFIX=EMP
STORAGE_PATH=./private-documents
MAX_UPLOAD_BYTES=10485760

# Required for production. Never commit real credentials or employee data.
ENTRA_TENANT_ID=
ENTRA_AUDIENCE=
AZURE_STORAGE_ACCOUNT_URL=
AZURE_STORAGE_CONTAINER=onboarding-private
AZURE_DOCUMENT_INTELLIGENCE_ENDPOINT=
FOUNDRY_PROJECT_ENDPOINT=https://employee-onboarding-kc-resource.services.ai.azure.com/api/projects/employee-onboarding-agent-kc
FOUNDRY_MODEL_DEPLOYMENT_NAME=gpt-4.1-mini
FOUNDRY_AGENT_NAME=employee-onboarding
FOUNDRY_AGENT_VERSION=

# Model-only smoke test. Managed agents continue to require Entra authentication.
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_BASE_URL=https://employee-onboarding-kc-resource.services.ai.azure.com/openai/v1/
AZURE_REGION=koreacentral
AZURE_TENANT_ID=''
AZURE_CLIENT_ID=''
AZURE_CLIENT_SECRET=''
AZURE_SUBSCRIPTION_ID=''
